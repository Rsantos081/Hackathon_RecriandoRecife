{
  "info": {
    "name": "API Recife - Chamados e Ocorrências",
    "description": "Collection para testar autenticação, relatos individuais e ocorrências agregadas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:5000" },
    { "key": "email_teste", "value": "teste@recife.local" },
    { "key": "senha_teste", "value": "Senha123!" },
    { "key": "access_token", "value": "" },
    { "key": "chamado_id", "value": "" }
  ],
  "item": [
    {
      "name": "Saúde",
      "item": [
        {
          "name": "Verificar API",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/saude"
          }
        }
      ]
    },
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Registrar usuário de teste",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuário de Teste\",\n  \"email\": \"{{email_teste}}\",\n  \"senha\": \"{{senha_teste}}\",\n  \"papel\": \"usuario\"\n}"
            },
            "url": "{{base_url}}/api/auth/registrar"
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const resposta = pm.response.json();",
                "if (resposta.access_token) {",
                "  pm.collectionVariables.set('access_token', resposta.access_token);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_teste}}\",\n  \"senha\": \"{{senha_teste}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Chamados",
      "item": [
        {
          "name": "Criar primeiro relato",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const resposta = pm.response.json();",
                "if (resposta.chamado?.id) {",
                "  pm.collectionVariables.set('chamado_id', resposta.chamado.id);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Lâmpada apagada\",\n  \"descricao\": \"Poste sem iluminação em frente ao número 120.\",\n  \"categoria\": \"iluminacao_publica\",\n  \"classificacao_geografica\": \"residencial\",\n  \"localizacao\": {\n    \"latitude\": -8.047562,\n    \"longitude\": -34.876964,\n    \"precisao_metros\": 15\n  }\n}"
            },
            "url": "{{base_url}}/api/chamados"
          }
        },
        {
          "name": "Criar relato próximo - deve agregar",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Poste apagado\",\n  \"descricao\": \"A iluminação continua apagada no mesmo trecho.\",\n  \"categoria\": \"iluminacao_publica\",\n  \"classificacao_geografica\": \"residencial\",\n  \"localizacao\": {\n    \"latitude\": -8.047600,\n    \"longitude\": -34.876950,\n    \"precisao_metros\": 15\n  }\n}"
            },
            "url": "{{base_url}}/api/chamados"
          }
        },
        {
          "name": "Listar meus relatos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/chamados"
          }
        },
        {
          "name": "Obter relato por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/chamados/{{chamado_id}}"
          }
        },
        {
          "name": "Atualizar meu relato",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Poste sem iluminação em frente ao número 120, Recife.\"\n}"
            },
            "url": "{{base_url}}/api/chamados/{{chamado_id}}"
          }
        }
      ]
    },
    {
      "name": "Ocorrências agregadas",
      "item": [
        {
          "name": "Listar ocorrências e criticidade",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/ocorrencias"
          }
        }
      ]
    },
    {
      "name": "Comentários",
      "item": [
        {
          "name": "Adicionar comentário",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Relato confirmado pelo solicitante.\"\n}"
            },
            "url": "{{base_url}}/api/chamados/{{chamado_id}}/comentarios"
          }
        },
        {
          "name": "Listar comentários",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/chamados/{{chamado_id}}/comentarios"
          }
        }
      ]
    }
  ]
}
